# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=change_me

# ── MongoDB ───────────────────────────────────────────────────────────────────
# These three are used by the MongoDB container on first boot to create the DB.
MONGO_INITDB_ROOT_USERNAME=clinic_user
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_INITDB_DATABASE=clinic_db

# Must match the credentials above.
MONGODB_URI=mongodb://clinic_user:change_me@mongodb:27017/clinic_db?authSource=admin

# ── Ollama (LLM inference) ────────────────────────────────────────────────────
# Ollama runs on the HOST machine, not inside Docker.
# Install from https://ollama.ai, then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Required to download the biomedical NER model (d4data/biomedical-ner-all)
# and MedCPT embeddings on first boot.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NCBI / PubMed ─────────────────────────────────────────────────────────────
# Your email address — NCBI requires this to identify API callers.
# No registration needed; just use a real address.
BIO_EMAIL=your@email.com

# ── ICD-11 API (WHO) ──────────────────────────────────────────────────────────
# Register at https://icd.who.int/icdapi to get client credentials.
ICD11_CLIENT_ID=your_icd11_client_id
ICD11_CLIENT_SECRET=your_icd11_client_secret

# ── Gmail SMTP (OTP email delivery) ──────────────────────────────────────────
# Use a Gmail App Password — NOT your account password.
# Generate one at: Google Account → Security → 2-Step Verification → App Passwords
# The app password is 16 characters with no spaces.
GOOGLE_EMAIL=your@gmail.com
GOOGLE_PASSWORD=xxxx xxxx xxxx xxxx

# Toggle GPU/CPUS
TORCH_DEVICE="cpu"